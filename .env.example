# YatraSetu AI – environment template. Copy to .env and fill in what you have.
# The app runs fully offline if OPENROUTER_API_KEY is left empty.

# --- AI generation: OpenRouter (OpenAI-compatible) through LangChain ---
OPENROUTER_API_KEY=
# Free zero-credit demo model. Switch to openai/gpt-4o-mini if your account has credits.
OPENROUTER_MODEL=recursive/flint-v1.0:free
# Optional comma-separated fallback models (OpenRouter routing)
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=YatraSetu AI
LLM_TEMPERATURE=0.1
# Reasoning models need headroom; 600 also works for non-reasoning models.
LLM_MAX_TOKENS=600
LLM_TIMEOUT=25

# --- Optional self-hosted OpenAI-compatible endpoint (used only if OPENROUTER_API_KEY is empty) ---
# LLM_API_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Optional Bhashini translation / voice for languages beyond English and Hindi ---
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=

# --- Demo dashboard accounts (change in production) ---
EDITOR_PASSWORD=editor123
APPROVER_PASSWORD=approver123

# --- Optional retrieval tuning ---
# YATRASETU_RETRIEVAL_THRESHOLD=0.12
# YATRASETU_CONTENT_THRESHOLD=0.05
# YATRASETU_DB=yatrasetu.db
